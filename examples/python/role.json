{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Shop",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "s3:CreateBucket",
        "s3:GetObject",
        "s3:PutObject",
        "sqs:CreateQueue",
        "sqs:SendMessage"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoRefunds",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:dynamodb:*:*:table/orders"
    }
  ]
}
