@@ -282,11 +282,23 @@ const PAGE_BYTES: u64 = 4_096;
 /// The interpreter exposes no allocation seam, so the memory a run holds is sampled from
 /// outside it, on the thread the run happens on. The count never falls, so the reading is an
 /// UPPER bound on what the run holds — the side to err on for a figure a bound is judged on.
+#[cfg(target_os = "linux")]
 #[must_use]
 pub fn faulted_bytes() -> u64 {
     page_bytes(::nix::sys::resource::UsageWho::RUSAGE_THREAD)
 }
 
+/// Hosts other than Linux report no memory per thread, and a figure for the whole process
+/// would charge one run with every other thread's memory (another function's, the host's)
+/// and stop runs that hold little. So a run's memory is not measured there: its
+/// `MemorySize` is not enforced and its "Max Memory Used" reads 0, while its `Timeout`
+/// still bounds it, as on Linux.
+#[cfg(not(target_os = "linux"))]
+#[must_use]
+pub fn faulted_bytes() -> u64 {
+    0
+}
